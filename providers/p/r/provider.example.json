        "url": "https://www.partner.example",
        "contacts": [{ "type": "email", "value": "onboarding@partner.example" }]
      }
    ],
    "cost": false,
    "agreementRequired": true,
    "agreementUrl": "https://partners.provider.example/domain-connect/terms",
    "requirements": {
      "signedTemplatesOnly": true,
      "warnPhishingRejected": true,
      "signingKeyPublished": true
    },
    "notes": "The template must be merged into the Templates repository before it is requested. Requests go through the onboarding partner; expect deployment within five working days."
  },
  "features": {
    "syncFlow": true,
    "syncRedirectUri": true,
    "asyncFlow": true,
    "asyncRevert": false,
    "templateStateTracking": true,
    "settings": {
      "urlControlPanel": true,
      "nameServers": true,
      "windowSize": true,
      "nonStandard": [
        { "key": "redirectSupported", "description": "Boolean; true when REDIR301/REDIR302 records can be applied for the domain." }
      ]
    },
    "templates": {
      "txtConflictMatching": true,
      "variablesInNumberFields": true,
      "multiInstance": true,
      "sharedNames": false,
      "essential": null
    },
    "recordTypes": {
      "spfm": true,
      "custom": false,
      "apexCname": false,
      "redir301": true,
      "redir302": true
    },
    "nonStandard": { "cnameFlattening": false }
  },
  "notes": "Dummy entry that shows every field of the format; provider.example is not a real DNS provider and all values are invented. The .example domains are reserved by RFC 2606, so none of the links resolve and the exampleDomain discovery check does not apply to this entry. essential is null to show an unknown value.",
