{
  "providerId": "cloudflare.com",
  "name": "Cloudflare",
  "url": "https://www.cloudflare.com",
  "exampleDomain": "cloudflare.com",
  "logo": {
    "format": "png",
    "data": ""
  },
  "documentation": [
    {
      "title": "Domain Connect",
      "url": "https://developers.cloudflare.com/dns/reference/domain-connect/"
    }
  ],
  "onboarding": {
    "mode": "on-request",
    "documentationUrl": "https://developers.cloudflare.com/dns/reference/domain-connect/",
    "contacts": [{ "type": "email", "value": "domain-connect@cloudflare.com" }],
    "requirements": {
      "signedTemplatesOnly": true,
      "warnPhishingRejected": false,
      "signingKeyPublished": true
    },
    "notes": "The template must first be merged into the Templates repository, then requested by email with: the template links, the FQDNs of the syncPubKeyDomain TXT records, a logo (SVG preferred), the default proxy status for A, AAAA and CNAME records, and optionally a Cloudflare account ID to test the template before it is published. syncBlock, if present, must be false. Templates with APEXCNAME fail onboarding. Lint with dc-template-linter -cloudflare. Template updates are picked up automatically (expected within eight hours); opting out is possible."
  },
  "features": {
    "syncFlow": true,
    "syncRedirectUri": true,
    "asyncFlow": false,
    "settings": { "urlControlPanel": false, "nameServers": false, "windowSize": false, "nonStandard": [] },
    "templates": {
      "txtConflictMatching": false,
      "multiInstance": false,
      "sharedNames": false,
      "essential": false
    },
    "recordTypes": {
      "spfm": true,
      "apexCname": false,
      "redir301": true,
      "redir302": true
    },
    "nonStandard": { "cnameFlattening": true }
  },
  "notes": "The signature (sig) is required and must be the last query parameter. state and serviceName in the apply URL are ignored. Ignored template properties: syncBlock, shared, sharedServiceName, syncRedirectDomain, multiInstance, warnPhishing, hostRequired; ignored record properties: essential, txtConflictMatchingMode, txtConflictMatchingPrefix (a template TXT record only conflicts with an identical TXT record, so SPF must use SPFM). REDIR301/REDIR302 become zone bulk redirect rules and replace existing bulk redirects. A CNAME on the apex is flattened.",
  "links": [
    {
      "url": "https://www.domainconnect.org/dns-providers/",
      "title": "Domain Connect: DNS Providers (onboarding contact, documentation link, logo)",
      "rel": "source",
